  "editor": "wokwi",
  "parts": [
    { "id": "uno", "type": "wokwi-arduino-uno", "left": 0, "top": 100 },
    { "id": "relay", "type": "wokwi-relay-module", "left": 320, "top": -20,
      "attrs": { "transistor": "npn" } },
    { "id": "led1", "type": "wokwi-led", "left": 520, "top": 60,
      "attrs": { "color": "red", "label": "stands in for the motor" } },
    { "id": "r1", "type": "wokwi-resistor", "left": 520, "top": 160,
      "attrs": { "value": "220" } },
    { "id": "note", "type": "wokwi-text", "left": 0, "top": -80,
      "attrs": { "text": "Wokwi has no DC motor or transistor part. The relay module contains the same driver circuit (transistor + flyback diode) that you build by hand at the bench, and the LED shows when it is on. The CODE is identical.", "fontSize": 15 } }
