    [ "uno:5V", "relay:COM", "red", [ "v30", "h40" ] ],
    [ "relay:NO", "led1:A", "green", [ "v0" ] ],
    [ "led1:C", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "uno:GND.2", "black", [ "v0" ] ]
  ]
