  "editor": "wokwi",
  "parts": [
    { "id": "uno", "type": "wokwi-arduino-uno", "left": 0, "top": 100 },
    { "id": "relay", "type": "wokwi-relay-module", "left": 320, "top": -20,
      "attrs": { "transistor": "npn" } },
    { "id": "led1", "type": "wokwi-led", "left": 520, "top": 60,
      "attrs": { "color": "yellow", "label": "stands in for the solenoid" } },
    { "id": "r1", "type": "wokwi-resistor", "left": 520, "top": 160,
      "attrs": { "value": "220" } },
    { "id": "note", "type": "wokwi-text", "left": 0, "top": -80,
      "attrs": { "text": "A relay is a coil switched by a transistor, which is exactly the solenoid circuit. You can HEAR the relay click on each pulse, so the rhythm of the tacton is audible even though there is no solenoid part.", "fontSize": 15 } }
  ],
  "connections": [
    [ "uno:6", "relay:IN", "blue", [ "v0" ] ],
    [ "uno:5V", "relay:VCC", "red", [ "v0" ] ],
    [ "uno:GND.1", "relay:GND", "black", [ "v0" ] ],
    [ "uno:5V", "relay:COM", "red", [ "v30", "h40" ] ],
    [ "relay:NO", "led1:A", "green", [ "v0" ] ],
    [ "led1:C", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "uno:GND.2", "black", [ "v0" ] ]
  ]
}
